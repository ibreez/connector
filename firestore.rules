rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated staff member
    function isAuthenticated() {
      return request.auth != null;
    }

    // Never allow storing passwords, OTPs, or session tokens in Firestore
    function doesNotContainSecrets(data) {
      return !('password' in data) &&
             !('otp' in data) &&
             !('token' in data) &&
             !('cookie' in data) &&
             !('sessionToken' in data);
    }

    match /bmlAccounts/{accountId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && doesNotContainSecrets(request.resource.data);
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && doesNotContainSecrets(request.resource.data);
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && doesNotContainSecrets(request.resource.data);
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
